<odoo>
    <record id="company_form_with_phytosanitary_reference" model="ir.ui.view">
        <field name="name">company.form.with.phytosanitary.reference</field>
        <field name="model">res.company</field>
        <field name="inherit_id" ref="base.view_company_form" />
        <field name="arch" type="xml">
            <xpath expr="//field[@name='company_registry']" position="after">
                <field name="phytosanitary_reference" />
            </xpath>
        </field>
    </record>
</odoo>
