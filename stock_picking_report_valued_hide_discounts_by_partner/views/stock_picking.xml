<odoo>
    <record
        id="stock_picking_report_valued_hide_discounts_by_partner"
        model="ir.ui.view"
    >
        <field name="name">stock.picking.report.valued.hide.discounts.by.partner</field>
        <field name="model">stock.picking</field>
        <field name="inherit_id" ref="stock.view_picking_form" />
        <field name="arch" type="xml">
            <xpath expr="//group[@name='other_infos']" position="inside">
                <field name="show_discounts" />
            </xpath>
        </field>
    </record>
</odoo>
